{# Shared shell for the login and installer pages: centred card, stacked fields. #}
{% extends 'base.html.twig' %}

{% block stylesheets %}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #f4f5f7; color: #1f2933; font: 16px/1.5 system-ui, sans-serif; }
        main { width: min(24rem, calc(100vw - 2rem)); padding: 2rem; background: #fff; border-radius: .5rem; box-shadow: 0 1px 8px rgb(0 0 0 / .1); }
        h1 { margin: 0 0 .5rem; font-size: 1.5rem; }
        p { margin: 0 0 1rem; }
        form { display: grid; gap: .25rem; }
        label { margin-top: .75rem; font-weight: 600; font-size: .9rem; }
        input { padding: .5rem .6rem; border: 1px solid #c3c8d0; border-radius: .3rem; font: inherit; }
        input:focus { outline: 2px solid #3b82f6; outline-offset: 0; border-color: transparent; }
        button { margin-top: 1.25rem; padding: .6rem; border: 0; border-radius: .3rem; background: #2563eb; color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
        button:hover { background: #1d4ed8; }
        [role=alert] { margin: 0 0 .5rem; padding: .6rem .75rem; border-radius: .3rem; background: #fdecea; color: #8a1f17; }
        code { padding: .1rem .3rem; border-radius: .2rem; background: #eef0f3; font-size: .85em; }
    </style>
{% endblock %}

{% block body %}
    <main>{% block content %}{% endblock %}</main>
{% endblock %}
