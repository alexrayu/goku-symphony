<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        {% set logo = site_logo_url(site) %}
        <link rel="icon" href="{{ logo ?? path('favicon') }}" type="{{ logo ? 'image/webp' : 'image/svg+xml' }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
