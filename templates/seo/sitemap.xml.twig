<?xml version="1.0" encoding="UTF-8"?>
{# lastmod is the first publication: of the newest chapter for home and works, of the chapter itself
   for chapter URLs. Oneshots have no chapter URL. #}
{% macro url(loc, date) %}
    <url><loc>{{ loc }}</loc>{% if date %}<lastmod>{{ date|date('c') }}</lastmod>{% endif %}</url>
{% endmacro %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{ _self.url(url('home'), (groups|first).updatedAt ?? null) }}
{% if site.hasAbout %}{{ _self.url(url('about'), null) }}{% endif %}
{% for group in groups %}
{{ _self.url(url('work_show', {slug: group.work.slug}), group.updatedAt) }}
    {% if group.work.type.value == 'series' %}
        {% for chapter in group.chapters %}
{{ _self.url(url('chapter_read', {slug: group.work.slug, number: chapter.numberLabel}), chapter.publishedAt) }}
        {% endfor %}
    {% endif %}
{% endfor %}
</urlset>
