{% extends 'public/layout.html.twig' %}

{% set oneshot = work.type.value == 'oneshot' %}
{% set chapter_name = 'Chapter ' ~ chapter.numberLabel ~ (chapter.title ? ': ' ~ chapter.title : '') %}
{% set work_url = url('work_show', {slug: work.slug}) %}
{% set canonical = oneshot ? work_url : url('chapter_read', {slug: work.slug, number: chapter.numberLabel}) %}
{% set seo = {
    title: (oneshot ? work.title : work.title ~ ' ' ~ chapter_name) ~ ' | ' ~ site_name,
    description: oneshot and work.description ? work.description : 'Read ' ~ work.title ~ (oneshot ? '' : ' ' ~ chapter_name) ~ ' online on ' ~ site_name ~ '.',
    canonical: canonical,
    image: chapter_cover_url(chapter),
    type: 'article',
    json_ld: oneshot ? {
        '@context': 'https://schema.org',
        '@type': 'ComicStory',
        name: work.title,
        description: work.description,
        url: canonical,
        image: chapter_cover_url(chapter),
    } : {
        '@context': 'https://schema.org',
        '@graph': [
            {
                '@type': 'ComicIssue',
                name: chapter_name,
                issueNumber: chapter.numberLabel,
                url: canonical,
                image: chapter_cover_url(chapter),
                isPartOf: {'@type': 'ComicSeries', name: work.title, url: work_url},
            },
            {
                '@type': 'BreadcrumbList',
                itemListElement: [
                    {'@type': 'ListItem', position: 1, name: site_name, item: url('home')},
                    {'@type': 'ListItem', position: 2, name: work.title, item: work_url},
                    {'@type': 'ListItem', position: 3, name: chapter_name, item: canonical},
                ],
            },
        ],
    },
} %}

{% block javascripts %}{{ importmap('app') }}{% endblock %}

{% block crumbs %}
    {% if oneshot %}
        <h1>{{ work.title }}</h1>
    {% else %}
        <a href="{{ work_url }}">{{ work.title }}</a>
        <h1 class="muted">{{ chapter_name }}</h1>
    {% endif %}
{% endblock %}

{% block main %}
    <main class="reader">
        {# Pages are scrambled tiles, rebuilt on canvas by the reader controller; the box reserves the space. #}
        <div class="pages" data-controller="reader" data-reader-tile-value="{{ constant('App\\Ingest\\DerivativeGenerator::TILE_SIZE') }}"
             data-reader-gutter-value="{{ constant('App\\Ingest\\DerivativeGenerator::TILE_GUTTER') }}">
            {% for page in pages %}
                <div class="page" data-reader-target="page" role="img" aria-label="Page {{ loop.index }}"
                     style="aspect-ratio: {{ page.width }} / {{ page.height }}; max-width: {{ page.width }}px"
                     data-src="{{ page_image_url(page) }}" data-width="{{ page.width }}" data-height="{{ page.height }}"
                     data-order="{{ page.tileOrder }}"></div>
            {% else %}
                <p class="reader-end muted">No pages yet.</p>
            {% endfor %}
        </div>
        <noscript><p class="reader-end">Turn on JavaScript to read this chapter.</p></noscript>
        {% if not oneshot %}
            <p class="reader-end"><a href="{{ work_url }}">Back to chapters</a></p>
        {% endif %}
    </main>
{% endblock %}
