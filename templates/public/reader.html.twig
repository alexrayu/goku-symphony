{% extends 'public/layout.html.twig' %}

{% set oneshot = work.type.value == 'oneshot' %}
{% set chapter_name = 'Chapter ' ~ chapter.numberLabel ~ (chapter.title ? ': ' ~ chapter.title : '') %}
{% set work_url = url('work_show', {slug: work.slug}) %}
{% set work_path = path('work_show', {slug: work.slug}) %}
{% set canonical = oneshot ? work_url : url('chapter_read', {slug: work.slug, number: chapter.numberLabel}) %}
{% set seo = {
    title: (oneshot ? work.title : work.title ~ ' ' ~ chapter_name) ~ ' | ' ~ site.name,
    description: (oneshot ? work.description : chapter.summary) ?: 'Read ' ~ work.title ~ (oneshot ? '' : ' ' ~ chapter_name) ~ ' online on ' ~ site.name ~ '.',
    canonical: canonical,
    image: oneshot ? work_cover_url(work, chapter) : chapter_cover_url(chapter),
    type: 'article',
    noindex: not chapter.published,
    json_ld: oneshot ? {
        '@context': 'https://schema.org',
        '@type': 'ComicStory',
        name: work.title,
        description: work.description,
        url: canonical,
        image: work_cover_url(work, chapter),
        datePublished: chapter.publishedAt ? chapter.publishedAt|date('c') : null,
    } : {
        '@context': 'https://schema.org',
        '@graph': [
            {
                '@type': 'ComicIssue',
                name: chapter_name,
                issueNumber: chapter.numberLabel,
                description: chapter.summary,
                datePublished: chapter.publishedAt ? chapter.publishedAt|date('c') : null,
                url: canonical,
                image: chapter_cover_url(chapter),
                isPartOf: {'@type': 'ComicSeries', name: work.title, url: work_url},
            },
            {
                '@type': 'BreadcrumbList',
                itemListElement: [
                    {'@type': 'ListItem', position: 1, name: site.name, item: url('home')},
                    {'@type': 'ListItem', position: 2, name: work.title, item: work_url},
                    {'@type': 'ListItem', position: 3, name: chapter_name, item: canonical},
                ],
            },
        ],
    },
} %}

{% block javascripts %}
    {# The first page is the LCP: fetch it alongside the JS, not after it. Matches the controller's fetch() (same-origin credentials). #}
    {% if pages is not empty %}<link rel="preload" as="fetch" href="{{ page_image_url(pages|first) }}" crossorigin="anonymous">{% endif %}
    {{ importmap('app') }}
{% endblock %}

{% macro chapter_link(work, chapter, label, key, class = '') %}
    {% if chapter %}
        <a class="button {{ class }}" href="{{ path('chapter_read', {slug: work.slug, number: chapter.numberLabel}) }}"
           aria-keyshortcuts="{{ key }}" title="{{ key == 'ArrowLeft' ? 'Left' : 'Right' }} arrow key">{{ label }}</a>
    {% endif %}
{% endmacro %}

{% block crumbs %}
    {% if not oneshot %}
        <span class="crumb"><a href="{{ work_path }}">{{ work.title }}</a></span>
    {% endif %}
{% endblock %}

{% block main %}
    <main class="reader">
        <header class="reader-head wrap">
            {% if not chapter.published %}<span class="badge draft">Draft preview</span>{% endif %}
            {% if oneshot %}
                <h1>{{ work.title }}</h1>
                {% if work.description %}<p class="muted">{{ work.description }}</p>{% endif %}
            {% else %}
                <h1>Chapter {{ chapter.numberLabel }}</h1>
                {% if chapter.title %}<p class="muted">{{ chapter.title }}</p>{% endif %}
                {% if chapter.summary %}<p class="summary">{{ chapter.summary }}</p>{% endif %}
                <nav class="chapter-nav" aria-label="Chapters">
                    {{ _self.chapter_link(work, previous, 'Previous', 'ArrowLeft') }}
                    <a class="button" href="{{ work_path }}">All chapters</a>
                    {{ _self.chapter_link(work, next, 'Next', 'ArrowRight') }}
                </nav>
            {% endif %}
        </header>
        {# Pages are scrambled tiles, rebuilt on canvas by the reader controller; the box reserves the space. #}
        <div class="reader-progress" aria-hidden="true"></div>
        <div class="pages" data-controller="reader" data-reader-tile-value="{{ constant('App\\Ingest\\DerivativeGenerator::TILE_SIZE') }}"
             data-reader-gutter-value="{{ constant('App\\Ingest\\DerivativeGenerator::TILE_GUTTER') }}"
             {% if previous %}data-reader-previous-value="{{ path('chapter_read', {slug: work.slug, number: previous.numberLabel}) }}"{% endif %}
             {% if next %}data-reader-next-value="{{ path('chapter_read', {slug: work.slug, number: next.numberLabel}) }}"{% endif %}>
            {% for page in pages %}
                <div class="page" data-reader-target="page" role="img" aria-label="Page {{ loop.index }}"
                     style="aspect-ratio: {{ page.width }} / {{ page.height }}; max-width: {{ page.width }}px"
                     data-src="{{ page_image_url(page) }}" data-width="{{ page.width }}" data-height="{{ page.height }}"
                     data-order="{{ page.tileOrder }}"></div>
            {% else %}
                <p class="reader-end muted">No pages yet.</p>
            {% endfor %}
        </div>
        <noscript><p class="reader-end">Turn on JavaScript to read this chapter.</p></noscript>
        <section class="reader-end">
            {% if oneshot %}
                <h2>The end</h2>
                <p class="muted">Thanks for reading {{ work.title }}.</p>
                <div class="chapter-nav"><a class="button primary" href="{{ path('home') }}">More works</a></div>
            {% else %}
                <h2>End of chapter {{ chapter.numberLabel }}</h2>
                <p class="muted">{{ next ? 'Up next: Chapter ' ~ next.numberLabel ~ (next.title ? ': ' ~ next.title) : 'You are caught up.' }}</p>
                <div class="chapter-nav">
                    {{ _self.chapter_link(work, previous, 'Previous', 'ArrowLeft') }}
                    <a class="button{{ next ? '' : ' primary' }}" href="{{ work_path }}">All chapters</a>
                    {{ _self.chapter_link(work, next, 'Next chapter', 'ArrowRight', 'primary') }}
                </div>
            {% endif %}
        </section>
    </main>
{% endblock %}
