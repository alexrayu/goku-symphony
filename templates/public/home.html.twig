{% extends 'public/layout.html.twig' %}

{% set seo = {
    title: site_name,
    description: site_description,
    canonical: url('home'),
    json_ld: {'@context': 'https://schema.org', '@type': 'WebSite', name: site_name, url: url('home')},
} %}

{% block main %}
    <main>
        <h1>{{ site_name }}</h1>
        <p class="muted">{{ site_description }}</p>
        <h2>Works</h2>
        {% if works is empty %}
            <p class="muted">Nothing published yet.</p>
        {% else %}
            <ul class="list">
                {% for work in works %}
                    <li><a href="{{ path('work_show', {slug: work.slug}) }}">{{ work.title }}</a></li>
                {% endfor %}
            </ul>
        {% endif %}
    </main>
{% endblock %}
