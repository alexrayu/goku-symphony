{% extends 'public/layout.html.twig' %}

{% set seo = {
    title: site.name,
    description: site.tagline ?? site.name,
    canonical: url('home'),
    json_ld: {'@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: url('home')},
} %}

{% block main %}
    <main class="wrap">
        <section class="intro">
            <h1>{{ site.name }}</h1>
            {% if site.tagline %}<p class="muted">{{ site.tagline }}</p>{% endif %}
        </section>
        <h2 class="section-title">Works{% if shelf is not empty %} <span>{{ shelf|length }}</span>{% endif %}</h2>
        {% if shelf is empty %}
            <p class="empty muted">Nothing published yet.</p>
        {% else %}
            <ul class="shelf">
                {% for item in shelf %}
                    {% set oneshot = item.work.type.value == 'oneshot' %}
                    {% set latest = item.chapters|last %}
                    <li class="card">
                        <a href="{{ path('work_show', {slug: item.work.slug}) }}">
                            {% if item.chapters|filter(c => c.new) is not empty %}<span class="badge new">New</span>{% endif %}
                            <img class="cover" src="{{ work_thumb_url(item.work, item.chapters|first) }}" alt="" width="400" height="560"
                                 {{ loop.index > 6 ? 'loading="lazy"' }} decoding="async">
                            <h3>{{ item.work.title }}</h3>
                            <p>
                                {% if oneshot %}
                                    Oneshot
                                {% else %}
                                    {{ item.chapters|length }} {{ item.chapters|length == 1 ? 'chapter' : 'chapters' }} &middot; Ch. {{ latest.numberLabel }}
                                {% endif %}
                            </p>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </main>
{% endblock %}
