{# Public pages: dark background suits reading; one inline stylesheet until an asset pipeline exists. #}
{% extends 'base.html.twig' %}

{% block stylesheets %}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body { margin: 0; background: #111; color: #e6e6e6; font: 16px/1.5 system-ui, sans-serif; }
        a { color: #8ab4f8; text-decoration: none; }
        a:hover { text-decoration: underline; }
        header { max-width: 1200px; margin: 0 auto; padding: 1rem; display: flex; gap: .75rem; align-items: baseline; flex-wrap: wrap; }
        header .site { font-weight: 700; color: #e6e6e6; }
        main { max-width: 1200px; margin: 0 auto; padding: 0 1rem 3rem; }
        h1 { margin: .5rem 0 1rem; font-size: 1.6rem; }
        ul.list { list-style: none; margin: 0; padding: 0; }
        ul.list li { border-top: 1px solid #2a2a2a; }
        ul.list a { display: block; padding: .75rem 0; }
        .muted { color: #9a9a9a; }
        /* Reader: pages edge to edge, no gaps; width/height attributes reserve the space. */
        main.reader { padding: 0; }
        .pages img { display: block; max-width: 100%; height: auto; margin: 0 auto; }
        .reader-end { padding: 2rem 1rem; text-align: center; }
    </style>
{% endblock %}

{% block body %}
    <header>
        <a class="site" href="{{ path('home') }}">Goku</a>
        {% block crumbs %}{% endblock %}
    </header>
    {% block main %}{% endblock %}
{% endblock %}
