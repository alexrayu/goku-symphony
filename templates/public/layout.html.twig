{# Public pages: dark background suits reading; one inline stylesheet, no render-blocking requests.
   Child templates set `seo`: title, description, and optionally canonical, image, type, json_ld, noindex. #}
{% extends 'base.html.twig' %}

{% block title %}{{ seo.title }}{% endblock %}

{% block stylesheets %}
    {% set description = seo.description|striptags|replace({"\n": ' '})|trim|slice(0, 160) %}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#111114">
    <meta name="description" content="{{ description }}">
    {% if seo.noindex ?? false %}
        <meta name="robots" content="noindex">
    {% endif %}
    {% if seo.canonical ?? null %}
        <link rel="canonical" href="{{ seo.canonical }}">
        <meta property="og:url" content="{{ seo.canonical }}">
    {% endif %}
    <meta property="og:site.name" content="{{ site.name }}">
    <meta property="og:type" content="{{ seo.type ?? 'website' }}">
    <meta property="og:title" content="{{ seo.title }}">
    <meta property="og:description" content="{{ description }}">
    {% if seo.image ?? null %}
        <meta property="og:image" content="{{ seo.image }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta name="twitter:card" content="summary_large_image">
    {% else %}
        <meta name="twitter:card" content="summary">
    {% endif %}
    {% if seo.json_ld ?? null %}
        <script type="application/ld+json">{{ seo.json_ld|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG'))|raw }}</script>
    {% endif %}
    <style>
        {{ include('theme/_base.css.twig') }}
        body { display: flex; flex-direction: column; min-height: 100vh; }
        .wrap { width: 100%; max-width: var(--wide); margin: 0 auto; padding: 0 1rem; }

        /* Site header and footer */
        .site-header { border-bottom: 1px solid var(--line); background: var(--surface); }
        .site-header .wrap { display: flex; align-items: center; gap: .75rem; min-height: 3.5rem; }
        .brand { display: flex; align-items: center; gap: .6rem; font-weight: 700; font-size: 1.05rem; white-space: nowrap; }
        .crumb { display: flex; align-items: center; gap: .75rem; min-width: 0; color: var(--muted); }
        .crumb::before { content: ""; width: 1px; height: 1.1rem; background: var(--line); }
        .crumb a { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .crumb a:hover, .site-footer a:hover, .site-nav a:hover { color: var(--text); }
        .site-nav { margin-left: auto; color: var(--muted); }
        .site-footer nav { display: flex; gap: 1.25rem; }
        main { flex: 1; }
        .site-footer { margin-top: 4rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .875rem; }
        .site-footer .wrap { display: flex; justify-content: space-between; gap: 1rem; padding-block: 1.5rem; }

        /* Home: intro and work shelf */
        .intro { padding-block: 3rem 1rem; }
        .intro h1 { margin: 0 0 .5rem; font-size: clamp(2rem, 5vw, 3rem); }
        .intro p { margin: 0; max-width: 40rem; font-size: 1.1rem; }
        .section-title { display: flex; align-items: baseline; gap: .6rem; margin: 2rem 0 1rem; font-size: 1.25rem; }
        .section-title span { color: var(--muted); font-size: .9rem; font-weight: 400; }
        .shelf { display: grid; grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); gap: 1.75rem 1.25rem; margin: 0; padding: 0; list-style: none; }
        .card a { display: block; }
        .cover { display: block; width: 100%; height: auto; aspect-ratio: 5 / 7; border-radius: var(--radius); background: var(--raised); object-fit: cover; box-shadow: 0 1px 0 rgb(255 255 255 / .04) inset, 0 8px 24px rgb(0 0 0 / .35); transition: transform .2s, box-shadow .2s; }
        .card a:hover .cover { transform: translateY(-3px); box-shadow: 0 0 0 2px var(--accent), 0 12px 28px rgb(0 0 0 / .45); }
        .card h3 { margin: .75rem 0 .2rem; font-size: 1rem; }
        .card a:hover h3 { color: var(--accent); }
        .card p { margin: 0; color: var(--muted); font-size: .875rem; }
        .badge { display: inline-block; padding: .1rem .5rem; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); font-size: .75rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
        .badge.draft { border-color: var(--accent); color: var(--accent); }
        .badge.new { border-color: var(--accent); background: var(--accent); color: var(--on-accent); }
        .card a { position: relative; }
        .card .badge.new { position: absolute; top: .5rem; left: .5rem; z-index: 1; }
        .empty { padding: 3rem 1rem; border: 1px dashed var(--line); border-radius: var(--radius); text-align: center; }

        /* Work: cover beside title and actions, then the chapter list */
        .work-head { display: grid; grid-template: "cover info" 1fr "cover actions" auto / minmax(0, 15rem) 1fr; column-gap: 2rem; padding-block: 2.5rem 1rem; }
        .work-head .cover { grid-area: cover; }
        .work-head > div { grid-area: info; align-self: end; }
        .work-head .actions { grid-area: actions; }
        .work-head h1 { margin: .5rem 0 .75rem; font-size: clamp(1.75rem, 4vw, 2.5rem); }
        .work-head p { margin: 0 0 1rem; max-width: 42rem; }
        .actions { display: flex; flex-wrap: wrap; gap: .6rem; }
        ul.list { margin: 0; padding: 0; border: 1px solid var(--line); border-radius: var(--radius); list-style: none; overflow: hidden; }
        ul.list li + li { border-top: 1px solid var(--line); }
        ul.list a { display: flex; align-items: baseline; gap: .75rem; padding: .9rem 1.1rem; transition: background .15s; }
        ul.list a:hover { background: var(--surface); }
        ul.list a::after { content: "\203A"; margin-left: .75rem; color: var(--muted); }
        .chapter-date { margin-left: auto; font-size: .875rem; white-space: nowrap; }
        .chapter-number { flex: none; font-weight: 600; }
        .chapter-title { min-width: 0; overflow: hidden; color: var(--muted); text-overflow: ellipsis; white-space: nowrap; }
        @media (max-width: 600px) {
            .work-head { grid-template: "cover info" auto "actions actions" auto / 7.5rem 1fr; gap: 1.25rem 1rem; padding-top: 1.5rem; }
            .work-head > div { align-self: center; }
            .work-head .actions .button { flex: 1; }
            .shelf { grid-template-columns: repeat(2, 1fr); gap: 1.5rem 1rem; }
        }

        /* Reader: pages edge to edge, no gaps; aspect-ratio reserves the space before the canvas draws. */
        .reader-head { padding-block: 1.5rem; text-align: center; }
        .reader-head .badge { margin-bottom: .6rem; }
        .reader-head h1 { margin: 0; font-size: 1.5rem; }
        .reader-head p { margin: .35rem 0 0; }
        .reader-head .summary { max-width: 40rem; margin: .75rem auto 0; }
        .chapter-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem; }
        .reader-head .chapter-nav { margin-top: 1rem; }
        /* Reading progress: a scroll-driven bar, no JS. Browsers without scroll timelines show nothing. */
        .reader-progress { display: none; }
        @supports (animation-timeline: scroll()) {
            .reader-progress { display: block; position: fixed; inset: 0 0 auto; z-index: 10; height: 3px; background: var(--accent); transform-origin: left; animation: progress linear both; animation-timeline: scroll(root); }
            @keyframes progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }
        }
        .pages { -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
        .page { margin: 0 auto; background: var(--surface); }
        .page:empty { background: linear-gradient(100deg, var(--surface) 40%, var(--raised) 50%, var(--surface) 60%) 0 0 / 300% 100%; animation: shimmer 1.6s linear infinite; }
        @keyframes shimmer { to { background-position: -150% 0; } }
        @media (prefers-reduced-motion: reduce) { .page:empty { animation: none; } }
        .page canvas { display: block; width: 100%; height: auto; }
        .page p { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: .75rem; margin: 0; padding: 3rem 1rem; color: var(--muted); }
        .page button { padding: .45rem 1rem; border: 1px solid var(--line); border-radius: 999px; background: var(--raised); color: var(--text); font: inherit; font-weight: 600; cursor: pointer; }
        .reader-end { margin: 2.5rem auto 0; padding: 2rem 1rem; max-width: 36rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); text-align: center; }
        .reader-end h2 { margin: 0 0 .25rem; font-size: 1.15rem; }
        .reader-end p { margin: 0 0 1.25rem; }

        /* About */
        .about { max-width: 44rem; padding-block: 3rem; }
        .about h1 { margin: 0 0 1.25rem; font-size: clamp(1.75rem, 4vw, 2.5rem); }
        .bio { font-size: 1.1rem; line-height: 1.7; }
        .links { display: flex; flex-wrap: wrap; gap: .6rem; margin: 2rem 0 0; padding: 0; list-style: none; }

        /* Errors */
        .error { padding-block: 5rem; text-align: center; }
        .error h1 { margin: 0; color: var(--accent); font-size: 4rem; }
        .error p { margin: .5rem 0 1.5rem; font-size: 1.1rem; }
    </style>
{% endblock %}

{% block body %}
    <header class="site-header">
        <div class="wrap">
            {{ include('theme/_brand.html.twig') }}
            {% block crumbs %}{% endblock %}
            {% if site.hasAbout %}<nav class="site-nav"><a href="{{ path('about') }}">About</a></nav>{% endif %}
        </div>
    </header>
    {% block main %}{% endblock %}
    <footer class="site-footer">
        <div class="wrap">
            <span>&copy; {{ 'now'|date('Y') }} {{ site.name }}</span>
            <nav>
                <a href="{{ path('home') }}">All works</a>
                {% if site.hasAbout %}<a href="{{ path('about') }}">About</a>{% endif %}
            </nav>
        </div>
    </footer>
{% endblock %}
