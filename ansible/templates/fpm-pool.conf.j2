; {{ ansible_managed }}
[www]
user = {{ app_user }}
group = {{ app_user }}
; Default name: the php-fpm AppArmor profile (apparmor-profiles package) only allows php*-fpm.sock.
listen = /run/php/php{{ php_version }}-fpm.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

; Few, short-lived children: the box has 2 GB for PostgreSQL, Redis, the worker and libvips.
pm = ondemand
pm.max_children = 4
pm.process_idle_timeout = 30s
pm.max_requests = 500

; Archive uploads take long on slow links.
request_terminate_timeout = 300
php_admin_value[memory_limit] = 256M
