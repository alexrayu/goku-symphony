# {{ ansible_managed }}
[Unit]
Description=goku Messenger worker
After=network.target postgresql.service redis-server.service
ConditionPathExists={{ app_root }}/current

[Service]
User={{ app_user }}
Group={{ app_user }}
# The symlink is resolved at start, so a restart picks up the new release.
WorkingDirectory={{ app_root }}/current
ExecStart=/usr/bin/php{{ php_version }} bin/console messenger:consume async --time-limit=3600 --memory-limit=200M --no-interaction
Restart=always
RestartSec=5
# SIGTERM lets the current message finish; a derivative job on a long strip can take a while.
TimeoutStopSec=300
# Bounds PHP and its vips child processes together.
MemoryMax=768M

[Install]
WantedBy=multi-user.target
