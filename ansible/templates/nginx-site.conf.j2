# {{ ansible_managed }}
{% for range in cloudflare_ranges %}
set_real_ip_from {{ range }};
{% endfor %}
real_ip_header CF-Connecting-IP;

server {
    listen 80;
    listen [::]:80;
    server_name {{ app_hostname }};
    return 301 https://$host$request_uri;
}

server {
    # 24.04 ships Nginx 1.24: http2 is still a listen flag.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ app_hostname }};

    ssl_certificate /etc/ssl/goku/origin.pem;
    ssl_certificate_key /etc/ssl/goku/origin.key;

    root {{ app_root }}/current/public;
    client_max_body_size {{ upload_max_size }};

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location ~ ^/index\.php(/|$) {
        fastcgi_pass unix:/run/php/php{{ php_version }}-fpm.sock;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;
        # realpath: each request sees one release, even mid-deploy.
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param HTTPS on;
        # Set here, so a client-sent copy never reaches PHP. Symfony answers with X-Accel-Redirect.
        fastcgi_param HTTP_X_SENDFILE_TYPE X-Accel-Redirect;
        fastcgi_param HTTP_X_ACCEL_MAPPING {{ app_root }}/shared/storage/=/_storage/;
        fastcgi_read_timeout 300s;
        internal;
    }

    # Storage files only after the media controller checked access.
    location /_storage/ {
        internal;
        alias {{ app_root }}/shared/storage/;
    }

    location ~ \.php$ {
        return 404;
    }
}
