# {{ ansible_managed }}
APP_ENV=prod
APP_DEBUG=0
APP_SECRET={{ app_secret }}
DEFAULT_URI=https://{{ app_hostname }}
{% macro quoted(value) %}"{{ value | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') }}"{% endmacro %}
SITE_NAME={{ quoted(site_name) }}
SITE_DESCRIPTION={{ quoted(site_description) }}
# Unix socket with peer auth (OS user = role) and persistent connections: a new TCP + SCRAM
# connection per request cost 5x the throughput on one vCPU.
DATABASE_URL="postgresql://{{ app_user }}@localhost/{{ app_user }}?host=/var/run/postgresql&serverVersion={{ postgres_version }}&charset=utf8&persistent=1"
MESSENGER_TRANSPORT_DSN=redis://127.0.0.1:6379/messages
STORAGE_PATH={{ app_root }}/shared/storage
# Nginx sets X-Sendfile-Type itself and drops any client copy; see nginx-site.conf.j2.
SYMFONY_TRUST_X_SENDFILE_TYPE_HEADER=1
