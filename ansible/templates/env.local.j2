# {{ ansible_managed }}
APP_ENV=prod
APP_DEBUG=0
APP_SECRET={{ app_secret }}
DEFAULT_URI=https://{{ app_hostname }}
DATABASE_URL="postgresql://{{ app_user }}:{{ db_password | urlencode }}@127.0.0.1:5432/{{ app_user }}?serverVersion={{ postgres_version }}&charset=utf8"
MESSENGER_TRANSPORT_DSN=redis://127.0.0.1:6379/messages
STORAGE_PATH={{ app_root }}/shared/storage
# Nginx sets X-Sendfile-Type itself and drops any client copy; see nginx-site.conf.j2.
SYMFONY_TRUST_X_SENDFILE_TYPE_HEADER=1
